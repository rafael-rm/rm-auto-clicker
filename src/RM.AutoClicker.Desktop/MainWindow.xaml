<Window
    x:Class="RM.AutoClicker.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RM.AutoClicker.Desktop.Controls"
    Title="RM Auto Clicker">
    <UserControl>
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" PreviewKeyDown="OnRootPreviewKeyDown">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="NarrowLayout">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="WideLayout">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="640" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="BasicSecondColumn.Width" Value="*" />
                            <Setter Target="MouseInput.(Grid.Column)" Value="1" />
                            <Setter Target="MouseInput.(Grid.Row)" Value="0" />
                            <Setter Target="LimitSecondColumn.Width" Value="*" />
                            <Setter Target="DurationOptions.(Grid.Column)" Value="1" />
                            <Setter Target="DurationOptions.(Grid.Row)" Value="0" />
                            <Setter Target="SecondaryActions.(Grid.Column)" Value="1" />
                            <Setter Target="SecondaryActions.(Grid.Row)" Value="0" />
                            <Setter Target="SecondaryActions.HorizontalAlignment" Value="Right" />
                            <Setter Target="SecondaryActions.Margin" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        <Grid x:Name="Layout" Padding="16" RowSpacing="4" MaxWidth="880" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel x:Name="SessionHeader" Spacing="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="ProductNameText" Text="RM Auto Clicker" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <Button x:Uid="Preferences" x:Name="PreferencesButton" Grid.Column="1">
                        <Button.Flyout>
                            <Flyout>
                                <ScrollViewer MaxHeight="400" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="12" Width="260">
                                    <ComboBox x:Uid="Theme" ItemsSource="{x:Bind ViewModel.ThemeLabels}" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                    <ComboBox x:Uid="LanguagePicker" ItemsSource="{x:Bind ViewModel.LanguageLabels}" SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanChangeLanguage, Mode=OneWay}" HorizontalAlignment="Stretch" />
                                    <TextBlock x:Uid="LanguageHint" TextWrapping="Wrap" />
                                    <StackPanel Spacing="8" Visibility="{x:Bind ToVisibility(ViewModel.LanguageChangePending), Mode=OneWay}">
                                        <InfoBar x:Uid="LanguagePending" x:Name="LanguageRestartNotice" IsOpen="{x:Bind ViewModel.LanguageChangePending, Mode=OneWay}" IsClosable="False" Severity="Informational">
                                            <InfoBar.Content>
                                                <Button x:Uid="RestartApp" x:Name="RestartAppButton" Command="{x:Bind ViewModel.RestartCommand}" />
                                            </InfoBar.Content>
                                        </InfoBar>
                                        <TextBlock Text="{x:Bind ViewModel.RestartError, Mode=OneWay}" Visibility="{x:Bind TextVisibility(ViewModel.RestartError), Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>
                                    <TextBlock x:Uid="PreferencesHint" TextWrapping="Wrap" />
                                </StackPanel>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="SessionStatus" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <Grid x:Name="SessionMetrics" ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="ClickLabel" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ClickCounter" Text="{x:Bind ViewModel.CounterText, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock x:Uid="TimeLabel" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="SessionElapsed" Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
            <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8" Padding="0,0,4,4">
                <InfoBar IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}" Visibility="{x:Bind ToVisibility(ViewModel.HasMessage), Mode=OneWay}" IsClosable="False" Severity="{x:Bind NoticeSeverity(ViewModel.IsMessageError), Mode=OneWay}" Title="{x:Bind NoticeTitle(ViewModel.IsMessageError), Mode=OneWay}" Message="{x:Bind ViewModel.Message, Mode=OneWay}" />
                <StackPanel Spacing="4" Visibility="{x:Bind ToVisibility(ViewModel.HasSessionDetails), Mode=OneWay}">
                    <TextBlock x:Uid="RateHint" Text="{x:Bind ViewModel.RateText, Mode=OneWay}" Visibility="{x:Bind TextVisibility(ViewModel.RateText), Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ActivePlanText, Mode=OneWay}" Visibility="{x:Bind TextVisibility(ViewModel.ActivePlanText), Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.PendingChangesText, Mode=OneWay}" Visibility="{x:Bind ToVisibility(ViewModel.ShowPendingChanges), Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock x:Uid="SuppressedHint" Visibility="{x:Bind ToVisibility(ViewModel.IsInputSuppressed), Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="BasicTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="24" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="BasicSecondColumn" Width="0" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="6">
                                <controls:AutoDismissNumberBox x:Uid="Speed" x:Name="SpeedInput" Value="{x:Bind ViewModel.ClicksPerSecond, Mode=TwoWay}" Minimum="1" Maximum="25" SmallChange="1" SpinButtonPlacementMode="Compact" AutomationProperties.HelpText="{x:Bind ViewModel.SpeedError, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.SpeedError, Mode=OneWay}" Visibility="{x:Bind TextVisibility(ViewModel.SpeedError), Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" />
                                <Slider x:Uid="SpeedSliderLabel" x:Name="SpeedSlider" Minimum="1" Maximum="25" StepFrequency="0.5" Value="{x:Bind ViewModel.SliderClicksPerSecond, Mode=TwoWay}" />
                                <TextBlock x:Uid="SpeedHint" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.IntervalText, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox x:Uid="Mouse" x:Name="MouseInput" Grid.Row="1" SelectedIndex="{x:Bind ViewModel.ButtonIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Top" AutomationProperties.HelpText="{x:Bind ViewModel.MouseError, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.MouseLabels}" />
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="6">
                                <TextBlock x:Uid="HotkeyTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.CurrentHotkeyText, Mode=OneWay}" TextWrapping="Wrap" />
                                <Button x:Uid="HotkeyCapture" x:Name="HotkeyCaptureButton" Command="{x:Bind ViewModel.BeginHotkeyCaptureCommand}" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Bind ViewModel.HotkeyAccessibleName, Mode=OneWay}" PreviewKeyDown="OnHotkeyPreviewKeyDown" PreviewKeyUp="OnHotkeyPreviewKeyUp" LostFocus="OnHotkeyCaptureLostFocus">
                                    <TextBlock Text="{x:Bind CaptureButtonText(ViewModel.HotkeyCaptureText, ViewModel.HasHotkeyDraft), Mode=OneWay}" TextWrapping="Wrap" />
                                </Button>
                                <StackPanel x:Name="HotkeyDraftActions" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ToVisibility(ViewModel.HasHotkeyDraft), Mode=OneWay}">
                                    <Button x:Uid="ApplyHotkey" Command="{x:Bind ViewModel.ApplyHotkeyCommand}" />
                                    <Button x:Uid="CancelHotkey" Command="{x:Bind ViewModel.CancelHotkeyCaptureCommand}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.HotkeyCaptureMessage, Mode=OneWay}" Visibility="{x:Bind TextVisibility(ViewModel.HotkeyCaptureMessage), Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Text="{x:Bind ViewModel.HotkeyEditHint, Mode=OneWay}" Visibility="{x:Bind ToVisibility(ViewModel.HasHotkeyEditHint), Mode=OneWay}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.HotkeyStatus, Mode=OneWay}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Expander x:Uid="Advanced" x:Name="AdvancedOptions" IsExpanded="False" Expanding="OnAdvancedExpanding" SizeChanged="OnAdvancedSizeChanged" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header><StackPanel Spacing="4"><TextBlock x:Uid="AdvancedTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" /><TextBlock Text="{x:Bind ViewModel.AdvancedSummary, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></Expander.Header>
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="StartTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <CheckBox x:Uid="Countdown" x:Name="InitialDelayToggle" IsChecked="{x:Bind ViewModel.HasInitialDelay, Mode=TwoWay}" />
                            <controls:AutoDismissNumberBox x:Uid="Delay" x:Name="DelayInput" Value="{x:Bind ViewModel.InitialDelaySeconds, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.HasInitialDelay, Mode=OneWay}" Minimum="0.1" Maximum="300" SpinButtonPlacementMode="Compact" AutomationProperties.HelpText="{x:Bind ViewModel.DelayError, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.DelayError, Mode=OneWay}" Visibility="{x:Bind TextVisibility(ViewModel.DelayError), Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Uid="CountdownHint" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <TextBlock x:Uid="LimitsTitle" TextWrapping="Wrap" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="20" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="LimitSecondColumn" Width="0" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="8">
                                <CheckBox x:Uid="ClickLimitToggle" IsChecked="{x:Bind ViewModel.HasClickLimit, Mode=TwoWay}" />
                                <controls:AutoDismissNumberBox x:Uid="ClickLimit" x:Name="ClickLimitInput" Value="{x:Bind ViewModel.MaximumClicks, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.HasClickLimit, Mode=OneWay}" Minimum="1" Maximum="1000000000" SpinButtonPlacementMode="Compact" AutomationProperties.HelpText="{x:Bind ViewModel.ClickLimitError, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.ClickLimitError, Mode=OneWay}" Visibility="{x:Bind TextVisibility(ViewModel.ClickLimitError), Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                            <StackPanel x:Name="DurationOptions" Grid.Row="1" Spacing="8">
                                <CheckBox x:Uid="DurationToggle" IsChecked="{x:Bind ViewModel.HasDurationLimit, Mode=TwoWay}" />
                                <controls:AutoDismissNumberBox x:Uid="Duration" x:Name="DurationInput" Value="{x:Bind ViewModel.MaximumDurationSeconds, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.HasDurationLimit, Mode=OneWay}" Minimum="0.1" Maximum="86400" SpinButtonPlacementMode="Compact" AutomationProperties.HelpText="{x:Bind ViewModel.DurationLimitError, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.DurationLimitError, Mode=OneWay}" Visibility="{x:Bind TextVisibility(ViewModel.DurationLimitError), Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="RhythmTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <controls:AutoDismissNumberBox x:Uid="Variation" x:Name="VariationInput" Value="{x:Bind ViewModel.VariationPercent, Mode=TwoWay}" Minimum="0" Maximum="50" SpinButtonPlacementMode="Compact" AutomationProperties.HelpText="{x:Bind ViewModel.VariationError, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.VariationError, Mode=OneWay}" Visibility="{x:Bind TextVisibility(ViewModel.VariationError), Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Uid="VariationHint" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                    </StackPanel>
                </Expander>
                <TextBlock x:Name="SaveFeedbackText" Text="{x:Bind ViewModel.SaveFeedback, Mode=OneWay}" Visibility="{x:Bind TextVisibility(ViewModel.SaveFeedback), Mode=OneWay}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </ScrollViewer>
            <StackPanel x:Name="OperationFooter" Grid.Row="2" Spacing="4">
                <TextBlock x:Uid="PendingHint" Visibility="{x:Bind ToVisibility(ViewModel.ShowPendingChanges), Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <Grid Visibility="{x:Bind ToVisibility(ViewModel.HasValidationError), Mode=OneWay}" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Uid="ReviewTitle" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.HelpText="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}" />
                    <Button x:Uid="Review" Grid.Column="1" Click="OnReviewValidation" />
                </Grid>
                <TextBlock Text="{x:Bind ViewModel.StartBlocker, Mode=OneWay}" Visibility="{x:Bind ToVisibility(ViewModel.ShowStartBlocker), Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid ColumnSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="Start" x:Name="StartButton" Command="{x:Bind ViewModel.StartCommand}" Style="{x:Bind PrimaryButtonStyle(ViewModel.CanEmphasizeStart), Mode=OneWay}" MinWidth="100" />
                        <Button x:Uid="Stop" x:Name="StopButton" Command="{x:Bind ViewModel.StopCommand}" Style="{x:Bind PrimaryButtonStyle(ViewModel.IsSessionActive), Mode=OneWay}" MinWidth="100" />
                    </StackPanel>
                    <Grid x:Name="SecondaryActions" Grid.Row="1" ColumnSpacing="8" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button x:Uid="Save" x:Name="SavePreferencesButton" Command="{x:Bind ViewModel.SaveCommand}" HorizontalAlignment="Stretch" />
                        <Button x:Uid="Hide" x:Name="TrayButton" Grid.Column="1" HorizontalAlignment="Stretch" Click="MinimizeToTray" />
                    </Grid>
                </Grid>
                <TextBlock Text="{x:Bind ViewModel.HotkeyOperationText, Mode=OneWay}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
    </UserControl>
</Window>
